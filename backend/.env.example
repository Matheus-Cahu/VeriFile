# Mesmo banco da plataforma web-ssiaas (vertex/web-ssiaas/docker-compose.yml).
DATABASE_URL=postgresql://vertex_user:vertex_pass@localhost:5432/vertex_db

# Porta HTTP. O app aponta EXPO_PUBLIC_API_BASE_URL para http://<IP-do-PC>:PORT
PORT=3001

# Client IDs OAuth do Google aceitos como "aud" do idToken, separados por vírgula.
# Inclua o googleWebClientId do app (app.json → expo.extra) e, se quiser, o da web.
GOOGLE_CLIENT_IDS=134992816030-h0rfc4oe0gnq2eqqn231o2ao6kf2frmg.apps.googleusercontent.com

# Mesmo(s) segredo(s) do web-ssiaas, para gerar o Bearer M2M devolvido no pareamento.
SIGNER_SECRETS=

# Addon N-API do core SSI-PQ (gerado com `npm run build` em vertex/ssi-pq-core).
SSI_PQ_CORE_PATH=../../vertex/ssi-pq-core/npm/ssi_pq_core.node
