{
  "name": "verifile-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend monolítico do VeriFile: login Google, credenciais pendentes e pareamento DID sobre o banco da plataforma web-ssiaas.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "postinstall": "prisma generate",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "google-auth-library": "^10.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22",
    "prisma": "7.8.0",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
