# URL base do backend do VeriFile (backend/, porta 3001) que o app chama após o login Google.
#
# IMPORTANTE: no celular, "localhost" = o próprio celular, NÃO o seu PC.
# Use o IP da sua máquina alcançável pelo aparelho:
#   - IP da VPN (atual)            -> http://100.116.96.78:3001
#   - IP da LAN (mesma Wi-Fi)      -> http://192.168.x.x:3001
#   - USB com `adb reverse tcp:3001 tcp:3001` -> http://localhost:3001
#
# Variáveis EXPO_PUBLIC_* são embutidas no bundle no build/start do Metro.
# Para sobrescrever localmente sem versionar, use .env.local.
EXPO_PUBLIC_API_BASE_URL=http://100.116.96.78:3001
